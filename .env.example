# ========================================
# LunchService — Environment Variables Example
# ========================================
# Скопируйте этот файл в .env.local, .env.dev или .env.prod
# и заполните значения для вашей среды

# ========================================
# Database
# ========================================
DB_HOST=localhost
DB_PORT=3307
DB_NAME=lunch_service
DB_USERNAME=root
DB_PASSWORD=root

# ========================================
# JWT Keys
# ========================================
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_BAR_AUTH_SECRET_KEY=your-bar-auth-secret-key-here

# ========================================
# Notification Service
# ========================================
NOTIFICATION_SERVICE_URL=http://localhost:8082
NOTIFICATION_INTERNAL_SERVICE_KEY=your-internal-service-key-here

# ========================================
# Food Service
# ========================================
FOOD_SERVICE_URL=http://localhost:8086

# ========================================
# Auth
# ========================================
APP_AUTH_GLOBAL_ADMIN_DEFAULT_EMAIL=admin@company.com
