# ====================================================================
# LunchService — Пример файла конфигурации
# ====================================================================
# Скопируй этот файл в .env и заполни значения:
#   cp .env.example .env
#
# Переменные с префиксом LOCAL_ — для локальной разработки (IDEA)
# Переменные без префикса — для Docker (dev/prod)
# ====================================================================

# ==================== Общие настройки (не меняются) ====================
API_SERVER_URL=http://localhost:8080
LOGGING_LEVEL=debug
ROOT_LOGGING_LEVEL=info

# ==================== Profile (Local) ====================
SPRING_PROFILES_ACTIVE=local

# ====================================================================
# === LOCAL ==========================================================
# === Переменные для локальной разработки (IDEA) =====================
# ====================================================================

# --- Database (Local) ---
LOCAL_DB_URL=jdbc:mysql://localhost:3306/lunch_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=<заполни-пароль>

# --- JWT (Local) ---
LOCAL_SECURITY_JWT_SECRET_KEY=<заполни-secret-key-минимум-64-символа>

# --- Auth Bootstrap ---
LOCAL_APP_AUTH_GLOBAL_ADMIN_DEFAULT_EMAIL=admin@company.com

# --- CORS (Local) ---
LOCAL_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# --- Venue Service (Local) ---
LOCAL_VENUE_SERVICE_URL=http://localhost:8081
LOCAL_VENUE_SERVICE_NAME=venue-service
LOCAL_VENUE_SERVICE_PATH=/api/v1/venues

# --- Hibernate (Local) ---
LOCAL_SPRING_JPA_HIBERNATE_DDL_AUTO=create

# ====================================================================
# === DEV ============================================================
# === Переменные для Docker Dev ======================================
# ====================================================================

# --- Database (Dev Docker) ---
DB_URL=jdbc:mysql://mysql:3306/lunch_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=lunchuser
DB_PASSWORD=<заполни-пароль-dev>

# --- JWT (Dev) ---
SECURITY_JWT_SECRET_KEY=<заполни-secret-key-dev>

# --- Auth Bootstrap ---
APP_AUTH_GLOBAL_ADMIN_DEFAULT_EMAIL=admin@company.com

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# --- Venue Service ---
VENUE_SERVICE_URL=http://venue-service:8081
VENUE_SERVICE_NAME=venue-service
VENUE_SERVICE_PATH=/api/v1/venues

# --- Hibernate ---
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- Logging ---
LOGGING_LEVEL=info
ROOT_LOGGING_LEVEL=info

# --- API ---
API_SERVER_URL=http://localhost:8080

# ====================================================================
# === PROD ===========================================================
# === Переменные для Docker Prod ====================================
# ====================================================================

# --- Database (Prod Docker) ---
DB_URL=jdbc:mysql://mysql:3306/lunch_service?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=lunchuser
DB_PASSWORD=<заполни-пароль-prod>

# --- JWT (Prod) ---
SECURITY_JWT_SECRET_KEY=<заполни-secret-key-prod>

# --- Auth Bootstrap ---
APP_AUTH_GLOBAL_ADMIN_DEFAULT_EMAIL=admin@company.com

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# --- Venue Service ---
VENUE_SERVICE_URL=http://venue-service:8081
VENUE_SERVICE_NAME=venue-service
VENUE_SERVICE_PATH=/api/v1/venues

# --- Hibernate ---
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- Logging ---
LOGGING_LEVEL=warn
ROOT_LOGGING_LEVEL=warn

# --- API ---
API_SERVER_URL=http://prod-server:8080
