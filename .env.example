# ========================================
# LunchService — Environment Variables Template
# ========================================
# Скопируйте соответствующий файл в .env и заполните значения.

# --- Profiles ---
SPRING_PROFILES_ACTIVE=local

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lunch_service
DB_USERNAME=root
DB_PASSWORD=

# --- Auth ---
APP_AUTH_GLOBAL_ADMIN_DEFAULT_EMAIL=admin@company.com!
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_BAR_AUTH_SECRET_KEY=change-me-to-a-secure-random-string

# --- External Services ---
NOTIFICATION_SERVICE_URL=http://localhost:8080
FOOD_SERVICE_URL=http://localhost:8080
NOTIFICATION_INTERNAL_SERVICE_KEY=change-me

# --- Prod-specific ---
API_BASE_URL=http://localhost:8080
VENUE_SERVICE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://prod-frontend:8080
